# Normalize line endings so Windows/macOS contributors stay consistent.
* text=auto eol=lf

# Gradle wrapper script must stay executable and LF on Unix-like systems.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
*.jks binary
